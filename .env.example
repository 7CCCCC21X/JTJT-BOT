# Telegram Bot Token,从 @BotFather 获取
TELEGRAM_BOT_TOKEN=123456:ABC-xxxx

# Etherscan API Key(V2 多链通用,一个 key 支持 ETH/BSC/Base/Arbitrum/Polygon)
# 免费注册: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YourApiKeyToken

# 轮询间隔(秒),默认 30
POLL_INTERVAL=30

# 可选:限制哪些 chat 可以使用,多个用逗号分隔(用 /id 查看自己的 chat id)
# 留空 = 任何人都能用
ALLOWED_CHAT_IDS=

# 可选:数据目录。Railway 挂了 Volume 会自动使用其挂载路径,一般无需设置
DATA_DIR=data

# 可选:某条链的自定义备用数据源(Etherscan 免费套餐不覆盖该链时优先尝试)
# 支持 FALLBACK_API_ETH / FALLBACK_API_BSC / FALLBACK_API_BASE / FALLBACK_API_ARB / FALLBACK_API_POLYGON
# FALLBACK_API_BSC=https://xxx.example.com/api
